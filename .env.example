# you-get 环境变量模板
# 复制为 .env 或 .env.production 后填入实际值
# APP_ENV=production 时启动会读 .env.production

# ---- SignSrv（签名服务，字幕下载需要） ----
SIGN_SRV_URL=http://127.0.0.1:8989

# ---- MediaCrawlerPro-Python 资源服务（cookies/proxy） ----
# 用户未显式传 --cookies 时，从此处拉
RESOURCE_SRV_URL=http://127.0.0.1:8990

# 是否启动时主动拉资源服务代理（true/false）
# 默认 false：避免本地 you-get 下载 B 站时浪费 KDL 额度（urllib + 代理与 B 站 CDN 不兼容，会降级直连）
# 改为 true 可让 you-get 启动时尝试拉代理（命令行 --srv-proxy 等价）
USE_SRV_PROXY=false
